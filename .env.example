# Copy to .env.local (or .env) and fill in. Both are gitignored; bun loads them automatically.
# Only used for local runs. In GitHub, set these as repository secrets instead.

# Required. TypeSafe key for the Jev gate.
TYPESAFE_API_KEY=

# Claude: set ONE of these, or leave both empty to use your local Claude Code login.
# Pay-per-use API key (use a spend-limited key):
ANTHROPIC_API_KEY=
# Or a subscription token from `claude setup-token`:
CLAUDE_CODE_OAUTH_TOKEN=

# Optional model overrides (defaults: fixer claude-sonnet-5, reviewer auto).
# FIXER_MODEL=claude-sonnet-5
# REVIEWER_MODEL=auto
